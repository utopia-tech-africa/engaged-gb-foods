generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  qc
  handler
  cluster_supervisor
  regional_supervisor
  national_ops
  national_quality
  admin
  gbfoods_reviewer
}

enum DepotReadiness {
  unknown
  ready
  hold
}

enum AttendanceKind {
  check_in
  check_out
}

enum VisitStatus {
  scheduled
  in_progress
  complete
  exception
}

enum StockZone {
  unexamined
  conforming_pending_release
  recoverable_pending_approval
  held_or_rejected
  released_remaining_on_site
}

enum StockUnit {
  cases
  loose_packs
}

enum StockEvidenceCategory {
  pack
  batch
  defect
  position
}

enum StockMovementType {
  opening
  disposition
}

enum DispositionDecision {
  release
  hold
  reject
  approve_repack
}

enum RecceDecision {
  ready
  hold
}

enum AssessmentResult {
  pass
  fail
  pending
}

enum SignatureRole {
  qc
  cluster_supervisor
  depot_representative
}

model User {
  id                String        @id @default(cuid())
  fullName          String
  staffId           String?       @unique
  email             String?       @unique
  phone             String?
  pinHash           String?
  passwordHash      String?
  role              UserRole
  isActive          Boolean       @default(true)
  failedPinAttempts Int           @default(0)
  lockedAt          DateTime?
  photoObjectKey    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sessions          AuthSession[]
  supervisedClusters Cluster[]    @relation("ClusterSupervisor")
  assignments       Assignment[]
  visits            Visit[]        @relation("VisitQcUser")
  attendances       Attendance[]
  stockLotsCreated  StockLot[]     @relation("StockLotCreatedBy")
  dispositions      Disposition[]
  visitSignatures   VisitSignature[] @relation("VisitSignatureSignedBy")
  recces            Recce[]        @relation("RecceAuthor")
  assessments       Assessment[]   @relation("AssessmentSubject")
  assessmentsGiven  Assessment[]   @relation("AssessmentAssessor")
  dailyReturnsSubmitted DailyReturn[] @relation("DailyReturnSubmitter")
  escalationsReported Escalation[] @relation("EscalationReporter")

  @@index([role])
  @@index([isActive])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Region {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  slug         String         @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  clusters     Cluster[]
  distributors Distributor[]
  assignments  Assignment[]
  dailyReturns DailyReturn[]

  @@index([isActive])
}

model Cluster {
  id               String         @id @default(cuid())
  regionId         String
  name             String
  code             String
  supervisorUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  region           Region         @relation(fields: [regionId], references: [id], onDelete: Cascade)
  supervisorUser   User?          @relation("ClusterSupervisor", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  distributors     Distributor[]
  assignments      Assignment[]

  @@unique([regionId, code])
  @@index([regionId])
  @@index([supervisorUserId])
}

model Distributor {
  id           String       @id @default(cuid())
  regionId     String
  clusterId    String?
  name         String
  code         String       @unique
  contactName  String?
  contactPhone String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  region       Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  cluster      Cluster?     @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  depots       Depot[]
  assignments  Assignment[]

  @@index([regionId])
  @@index([clusterId])
  @@index([isActive])
}

model Depot {
  id             String         @id @default(cuid())
  distributorId  String
  code           String
  name           String
  address        String
  latitude       Float?
  longitude      Float?
  contactName    String?
  contactPhone   String?
  openingHours   String?
  readiness      DepotReadiness @default(unknown)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  distributor    Distributor    @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  visits         Visit[]
  attendances    Attendance[]
  recces         Recce[]
  escalations    Escalation[]

  @@unique([distributorId, code])
  @@index([distributorId])
  @@index([isActive])
  @@index([readiness])
}

model Assignment {
  id            String       @id @default(cuid())
  userId        String
  distributorId String?
  clusterId     String?
  regionId      String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  cluster       Cluster?     @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  region        Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([distributorId])
  @@index([clusterId])
  @@index([regionId])
  @@index([effectiveFrom])
}

model Visit {
  id           String            @id @default(cuid())
  code         String            @unique
  depotId      String
  qcUserId     String
  date         DateTime          @db.Date
  status       VisitStatus       @default(scheduled)
  reconciledAt DateTime?
  lastSyncedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  depot        Depot             @relation(fields: [depotId], references: [id], onDelete: Cascade)
  qcUser       User              @relation("VisitQcUser", fields: [qcUserId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  stockLots    StockLot[]
  signatures   VisitSignature[]
  openActions  VisitOpenAction[]
  escalations  Escalation[]

  @@unique([depotId, qcUserId, date])
  @@index([depotId])
  @@index([qcUserId])
  @@index([date])
  @@index([status])
}

model Attendance {
  id             String         @id @default(cuid())
  visitId        String?
  userId         String
  depotId        String
  kind           AttendanceKind
  photoObjectKey String
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  capturedAt     DateTime
  createdAt      DateTime       @default(now())
  visit          Visit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  depot          Depot          @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@index([depotId])
  @@index([userId])
  @@index([visitId])
  @@index([capturedAt])
  @@index([depotId, capturedAt])
}

model Sku {
  id          String     @id @default(cuid())
  name        String     @unique
  brand       String?
  packFactor  Int        @default(1)
  caseUnit    String
  looseUnit   String
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  stockLots   StockLot[]

  @@index([isActive])
}

model DefectCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model StockLot {
  id               String     @id @default(cuid())
  visitId          String
  skuId            String
  batchCode        String
  expiryDate       DateTime?  @db.Date
  zone             StockZone
  quantity         Int
  unit             StockUnit
  baseQuantity     Int
  custodian        String?
  notes            String?
  latitude         Float?
  longitude        Float?
  accuracyMeters   Float?
  createdByUserId  String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  visit            Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  sku              Sku        @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdBy        User       @relation("StockLotCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  evidence         StockEvidence[]
  movements        StockMovement[]
  dispositions     Disposition[]

  @@index([visitId])
  @@index([skuId])
  @@index([zone])
  @@index([createdByUserId])
  @@index([createdAt])
}

model StockEvidence {
  id          String                @id @default(cuid())
  stockLotId  String
  category    StockEvidenceCategory
  objectKey   String
  capturedAt  DateTime
  createdAt   DateTime              @default(now())
  stockLot    StockLot              @relation(fields: [stockLotId], references: [id], onDelete: Cascade)

  @@index([stockLotId])
  @@index([category])
}

model StockMovement {
  id          String            @id @default(cuid())
  stockLotId  String
  type        StockMovementType
  quantity    Int
  baseQuantity Int
  createdAt   DateTime          @default(now())
  stockLot    StockLot          @relation(fields: [stockLotId], references: [id], onDelete: Cascade)

  @@index([stockLotId])
  @@index([type])
}

model Disposition {
  id              String              @id @default(cuid())
  stockLotId      String
  decision        DispositionDecision
  reason          String
  decidedByUserId String
  decidedAt       DateTime            @default(now())
  stockLot        StockLot            @relation(fields: [stockLotId], references: [id], onDelete: Cascade)
  decidedBy       User                @relation(fields: [decidedByUserId], references: [id], onDelete: Cascade)

  @@index([stockLotId])
  @@index([decidedByUserId])
  @@index([decidedAt])
}

model VisitSignature {
  id             String        @id @default(cuid())
  visitId        String
  role           SignatureRole
  signerName     String
  imageObjectKey String?
  signedAt       DateTime      @default(now())
  signedByUserId String?
  visit          Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  signedBy       User?         @relation("VisitSignatureSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)

  @@unique([visitId, role])
  @@index([visitId])
}

model VisitOpenAction {
  id                String    @id @default(cuid())
  visitId           String
  description       String
  ownerName         String
  dueAt             DateTime?
  acceptedByGBfoods Boolean   @default(false)
  createdAt         DateTime  @default(now())
  visit             Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
}

model Recce {
  id           String          @id @default(cuid())
  depotId      String
  /// { access, stockEstimate, workspace, power, signal, holdingZones: boolean; stockEstimateNote?: string }
  checklist    Json
  decision     RecceDecision
  notes        String?
  authorUserId String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  depot        Depot           @relation(fields: [depotId], references: [id], onDelete: Cascade)
  author       User            @relation("RecceAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  gaps         RecceGap[]
  evidence     RecceEvidence[]

  @@index([depotId])
  @@index([decision])
}

model RecceGap {
  id          String    @id @default(cuid())
  recceId     String
  description String
  ownerName   String
  dueAt       DateTime?
  isCritical  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  recce       Recce     @relation(fields: [recceId], references: [id], onDelete: Cascade)

  @@index([recceId])
}

model RecceEvidence {
  id         String   @id @default(cuid())
  recceId    String
  objectKey  String
  capturedAt DateTime
  createdAt  DateTime @default(now())
  recce      Recce    @relation(fields: [recceId], references: [id], onDelete: Cascade)

  @@index([recceId])
}

model Assessment {
  id               String           @id @default(cuid())
  userId           String
  safetyPass       Boolean
  qualityPass      Boolean
  recordsPass      Boolean
  /// Derived: all three mandatory steps true -> pass, otherwise fail.
  result           AssessmentResult
  notes            String?
  assessedByUserId String
  assessedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation("AssessmentSubject", fields: [userId], references: [id], onDelete: Cascade)
  assessedBy       User             @relation("AssessmentAssessor", fields: [assessedByUserId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([result])
}

model DailyReturn {
  id                 String   @id @default(cuid())
  regionId           String
  date               DateTime @db.Date
  submittedAt        DateTime @default(now())
  submittedByUserId  String
  coverageSummary    String
  stockStatusSummary String
  variancesSummary   String?
  incidentsSummary   String?
  depotsPlanned      Int
  depotsCompleted    Int
  depotsException    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  region             Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  submittedBy        User     @relation("DailyReturnSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  @@unique([regionId, date])
  @@index([date])
  @@index([regionId])
}

enum EscalationTrigger {
  quality_or_safety
  count_mismatch
  access_or_crew
  excess_volume_or_delay
}

enum EscalationStatus {
  open
  in_progress
  resolved
}

model Escalation {
  id               String               @id @default(cuid())
  visitId          String?
  depotId          String
  trigger          EscalationTrigger
  status           EscalationStatus     @default(open)
  note             String
  ownerName        String?
  dueAt            DateTime?
  writtenRecord    String?
  reportedByUserId String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  resolvedAt       DateTime?
  visit            Visit?               @relation(fields: [visitId], references: [id], onDelete: SetNull)
  depot            Depot                @relation(fields: [depotId], references: [id], onDelete: Cascade)
  reportedBy       User                 @relation("EscalationReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  evidence         EscalationEvidence[]

  @@index([depotId])
  @@index([visitId])
  @@index([status])
  @@index([createdAt])
}

model EscalationEvidence {
  id           String     @id @default(cuid())
  escalationId String
  objectKey    String
  capturedAt   DateTime
  createdAt    DateTime   @default(now())
  escalation   Escalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)

  @@index([escalationId])
}
